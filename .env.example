# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL (PostgreSQL) Runtime Variables (Injected automatically by AI Studio)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="secret"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_secret"

# JWT & Sécurité Authentification ChessMaster Pro
JWT_SECRET="chessmaster-pro-super-secret-jwt-key-2026"
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER="chessmaster@ethereal.email"
SMTP_PASS="smtp_password"

